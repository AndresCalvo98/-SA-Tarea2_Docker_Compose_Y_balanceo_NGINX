<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= noticia.titulo %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <header class="main-header">
        <div class="container">
            <h1><a href="/" style="color: white; text-decoration: none;">🌐 Tech & AI News</a></h1>
        </div>
    </header>

    <div class="instance-banner">
        Respondiendo desde la instancia: <strong><%= instanceId %></strong>
    </div>

    <main class="container">
        <article class="full-article">
            <header class="article-header">
                <span class="category"><%= noticia.categoria %></span>
                <h1><%= noticia.titulo %></h1>
                <p class="date">Publicado el <%= noticia.fecha %></p>
                <p class="ai-source-banner">⚠️ <strong>Advertencia:</strong> <%= noticia.ai_source %></p>
            </header>
            
            <img src="<%= noticia.imagen %>" alt="<%= noticia.titulo %>" class="hero-image">
            
            <div class="article-content">
                <p class="summary-lead"><strong><%= noticia.resumen %></strong></p>
                <p><%= noticia.contenido %></p>
            </div>
            
            <a href="/" class="back-button">&larr; Volver al inicio</a>
        </article>
    </main>

    <footer class="main-footer">
        <div class="container">
            <p>Proyecto académico de Sistemas Abiertos. <br> Todas las noticias mostradas en este portal han sido generadas mediante inteligencia artificial.</p>
        </div>
    </footer>
</body>
</html>
